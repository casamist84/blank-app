  /**
   * Calculate the aggregate confidence score for a perspective based on its children
   */
  private calculateAggregateConfidence(perspective: PerspectiveResponse): number {
    if (perspective.childPerspectives.length === 0) {
      return perspective.confidenceScore;
    }
    
    // Calculate the average confidence of child perspectives
    const childConfidenceSum = perspective.childPerspectives.reduce(
      (sum, child) => sum + child.confidenceScore, 
      0
    );
    
    const childConfidenceAvg = childConfidenceSum / perspective.childPerspectives.length;
    
    // Blend the perspective's own confidence with its children's confidence
    // giving slightly more weight to the more confident value
    return perspective.confidenceScore > childConfidenceAvg
      ? 0.6 * perspective.confidenceScore + 0.4 * childConfidenceAvg
      : 0.4 * perspective.confidenceScore + 0.6 * childConfidenceAvg;
  }
  
  /**
   * Count the total number of perspectives created in the tree
   */
  private countTotalPerspectives(rootPerspective: PerspectiveResponse): number {
    let count = 1; // Count the root perspective
    
    // Count all child perspectives recursively
    for (const child of rootPerspective.childPerspectives) {
      count += this.countTotalPerspectives(child);
    }
    
    return count;
  }
  
  /**
   * Measure the maximum recursion depth in the perspective tree
   */
  private measureRecursionDepth(perspective: PerspectiveResponse, currentDepth: number = 0): number {
    if (perspective.childPerspectives.length === 0) {
      return currentDepth;
    }
    
    // Find the maximum depth among all child perspectives
    const childDepths = perspective.childPerspectives.map(
      child => this.measureRecursionDepth(child, currentDepth + 1)
    );
    
    return Math.max(...childDepths);
  }
  
