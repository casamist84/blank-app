    };
  }
  
  /**
   * Remove duplicates from weighted items, keeping highest weight
   */
  private deduplicateWeightedItems(items: any[]): any[] {
    const uniqueMap = new Map();
    
    items.forEach(item => {
      const key = item.text;
      if (!uniqueMap.has(key) || uniqueMap.get(key).weight < item.weight) {
        uniqueMap.set(key, item);
      }
    });
    
    return Array.from(uniqueMap.values());
  }
  
