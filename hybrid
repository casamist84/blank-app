    );
    
    // Calculate average confidence
    const totalConfidence = subInstances.reduce((sum, instance) => {
      const instanceConfidence = Object.values(instance.results).reduce((subSum, result: any) => 
        subSum + (result.confidenceScore || 0), 0
      );
      return sum + instanceConfidence / Object.keys(instance.results).length;
    }, 0);
    
