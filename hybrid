function containsWords(text: string, words: string[]): boolean {
  return words.some(word => text.includes(word));
}

function inferQuestionDomain(question: string): string {
  const lower = question.toLowerCase();

  if (containsWords(lower, ['physics', 'quantum', 'gravity', 'space', 'energy', 'particle'])) return 'physics';
  if (containsWords(lower, ['math', 'equation', 'number', 'proof', 'theorem'])) return 'mathematics';
  if (containsWords(lower, ['computer', 'algorithm', 'code', 'programming'])) return 'computer_science';
  if (containsWords(lower, ['philosophy', 'ethics', 'existence', 'consciousness'])) return 'philosophy';
  if (containsWords(lower, ['biology', 'evolution', 'cell', 'organism', 'dna'])) return 'biology';
  if (containsWords(lower, ['history', 'ancient', 'civilization', 'war', 'empire'])) return 'history';

  return 'interdisciplinary';
}

